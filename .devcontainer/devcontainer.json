{
  "name": "Linux Mint Cinnamon Workspace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "desktopElement": "cinnamon"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Cinnamon Desktop Stream",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y cinnamon-desktop-environment lightdm"
}
