{
  "name": "Linux Mint Cinnamon Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "desktopElement": "cinnamon"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Cinnamon Desktop Stream",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  }
}
